# Optional placeholders for future local tooling; WordPress does not load this automatically.
JABAN_CONTENT_URL=https://jaban.co.kr
JABAN_SHOP_URL=https://gorebob.com
JABAN_PROJECT_STAGE=local
# Never copy existing operational tokens into this file.

# Cafe24 hosting login: keep real values in .env only.
CAFE24_HOSTING_LOGIN_URL=https://hosting.cafe24.com/
CAFE24_HOSTING_ID=your-id
CAFE24_HOSTING_PASSWORD=your-password

# WordPress Admin
WP_SITE_URL=https://your-site.mycafe24.com
WP_ADMIN_URL=https://your-site.mycafe24.com/wp-admin/
WP_ADMIN_USER=your-wp-admin
WP_ADMIN_PASSWORD=your-wp-password
WP_ADMIN_EMAIL=your-email@example.com

# Cafe24 FTP / SSH / DB
CAFE24_FTP_HOST=your-site.mycafe24.com
CAFE24_FTP_USER=your-ftp-user
CAFE24_FTP_PASSWORD=your-ftp-password

